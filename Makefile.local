private-init:
	python scripts/init_private_workspace.py

private-backup:
	python scripts/backup_private_catalog.py

boundary-check:
	python scripts/check_public_boundary.py

assets-import:
	@test -n "$(FILE)" || (echo "Usage: make -f Makefile.local assets-import FILE=/secure/path/assets.csv" && exit 2)
	python scripts/import_private_assets.py --csv "$(FILE)"

era5-plan:
	@test -n "$(YEAR)" || (echo "Usage: make -f Makefile.local era5-plan YEAR=2025" && exit 2)
	python scripts/plan_era5_local.py --year "$(YEAR)"

era5-run:
	@test -n "$(YEAR)" || (echo "Usage: make -f Makefile.local era5-run YEAR=2025" && exit 2)
	python scripts/run_era5_local.py --year "$(YEAR)"

jrc-plan:
	python scripts/plan_jrc_flood_local.py

jrc-run:
	python scripts/run_jrc_flood_local.py

chirps-plan:
	@test -n "$(YEAR)" || (echo "Usage: make -f Makefile.local chirps-plan YEAR=2025" && exit 2)
	python scripts/plan_chirps_local.py --year "$(YEAR)"

chirps-baseline:
	python scripts/extract_chirps_baseline_local.py

chirps-year:
	@test -n "$(YEAR)" || (echo "Usage: make -f Makefile.local chirps-year YEAR=2025" && exit 2)
	python scripts/extract_chirps_year_local.py --year "$(YEAR)"

chirps-run:
	@test -n "$(YEAR)" || (echo "Usage: make -f Makefile.local chirps-run YEAR=2025" && exit 2)
	python scripts/run_chirps_rainfall_local.py --year "$(YEAR)"

copdem-plan:
	python scripts/plan_copdem_local.py

copdem-run:
	python scripts/run_copdem_local.py

osm-network:
	python scripts/prepare_osm_network_local.py

route-endpoints:
	@test -n "$(FILE)" || (echo "Usage: make -f Makefile.local route-endpoints FILE=/secure/path/endpoints.csv" && exit 2)
	python scripts/import_route_endpoints.py --csv "$(FILE)"

route-dependencies:
	@test -n "$(FILE)" || (echo "Usage: make -f Makefile.local route-dependencies FILE=/secure/path/dependencies.csv" && exit 2)
	python scripts/import_route_dependencies.py --csv "$(FILE)"

osm-routes:
	python scripts/run_osm_routes_local.py

route-flood:
	python scripts/run_route_flood_exposure_local.py --return-period 100

drought-spi:
	@test -n "$(YEAR)" || (echo "Usage: make -f Makefile.local drought-spi YEAR=2025" && exit 2)
	python scripts/run_chirps_spi_local.py --year "$(YEAR)"

soil-plan:
	@test -n "$(YEAR)" || (echo "Usage: make -f Makefile.local soil-plan YEAR=2025" && exit 2)
	python scripts/plan_era5_soil_moisture_local.py --year "$(YEAR)"

soil-run:
	@test -n "$(YEAR)" || (echo "Usage: make -f Makefile.local soil-run YEAR=2025" && exit 2)
	python scripts/run_era5_soil_moisture_local.py --year "$(YEAR)"

aqueduct-run:
	@test -n "$(FILE)" && test -n "$(URL)" || (echo "Usage: make -f Makefile.local aqueduct-run FILE=/secure/path/aqueduct.zip URL=https://official-source/... [LAYER=layer_name]" && exit 2)
	python scripts/run_aqueduct4_baseline_local.py --file "$(FILE)" --source-url "$(URL)" $(if $(LAYER),--layer "$(LAYER)",)

cyclone-run:
	python scripts/run_ibtracs_cyclone_context_local.py --start-year 1980

worldpop-run:
	python scripts/run_worldpop_population_context_local.py --year 2025

ghsl-built-run:
	@test -n "$(TILE_DIR)" || (echo "Usage: make -f Makefile.local ghsl-built-run TILE_DIR=/secure/path/ghsl_tiles" && exit 2)
	python scripts/run_ghsl_built_context_local.py --tile-dir "$(TILE_DIR)"

gfm-event:
	@test -n "$(START)" && test -n "$(END)" || (echo "Usage: make -f Makefile.local gfm-event START=2025-07-15T00:00:00Z END=2025-07-20T23:59:59Z" && exit 2)
	python scripts/run_gfm_event_local.py --start "$(START)" --end "$(END)"

ffwc-stations:
	@test -n "$(FILE)" && test -n "$(URL)" || (echo "Usage: make -f Makefile.local ffwc-stations FILE=/secure/path/stations.csv URL=https://official-source/..." && exit 2)
	python scripts/import_ffwc_stations.py --csv "$(FILE)" --source-url "$(URL)"

ffwc-observations:
	@test -n "$(FILE)" && test -n "$(URL)" || (echo "Usage: make -f Makefile.local ffwc-observations FILE=/secure/path/observations.csv URL=https://official-source/..." && exit 2)
	python scripts/import_ffwc_observations.py --csv "$(FILE)" --source-url "$(URL)"

ffwc-link:
	python scripts/link_assets_ffwc.py --top-k 3

ffwc-event:
	@test -n "$(START)" && test -n "$(END)" || (echo "Usage: make -f Makefile.local ffwc-event START=2025-07-15T00:00:00+06:00 END=2025-07-20T23:59:59+06:00" && exit 2)
	python scripts/run_ffwc_event_context_local.py --start "$(START)" --end "$(END)"

local-test:
	pytest -q tests/test_local_store.py tests/test_local_assets.py tests/test_era5_local.py tests/test_jrc_flood.py tests/test_jrc_local.py tests/test_jrc_lineage.py tests/test_chirps.py tests/test_chirps_local.py tests/test_dem_context.py tests/test_copdem_local.py tests/test_copdem_lineage.py tests/test_osm_local.py tests/test_logistics.py tests/test_logistics_directed.py tests/test_route_flood_local.py tests/test_gfm_local.py tests/test_ffwc_local.py tests/test_drought.py tests/test_era5_soil_moisture_local.py tests/test_aqueduct_local.py tests/test_ibtracs_local.py tests/test_worldpop_local.py tests/test_ghsl_built_local.py tests/test_public_boundary.py

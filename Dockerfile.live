FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends     curl ca-certificates libgdal-dev gdal-bin &&     rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-live.txt .
RUN pip install --no-cache-dir -r requirements-live.txt
COPY . .
ENV PYTHONPATH=/app/src:/app
CMD ["python","scripts/preflight_live_integration.py"]
